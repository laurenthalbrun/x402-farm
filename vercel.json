{
  "version": 2,
  "functions": {
    "api/index.js": {
      "memory": 1769,
      "maxDuration": 60,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "x402-farm.vercel.app"
        }
      ],
      "destination": "https://api.x-402.online/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/radar/run",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/free/sante/mini",
      "schedule": "*/30 * * * *"
    }
  ]
}