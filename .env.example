# Adresse USDC qui encaisse (wallet Coinbase CDP) — vide = mode gratuit de dev
PAY_TO=

# eip155:84532 = Base Sepolia (testnet, USDC de faucet)
# eip155:8453  = Base mainnet (vrais USDC)
NETWORK=eip155:84532

# Facilitateur : x402.org (gratuit, testnet ok). En mainnet -> facilitateur Coinbase CDP
FACILITATOR_URL=https://x402.org/facilitator

PORT=3402
BROWSER_CONCURRENCY=4

# ---------------------------------------------------------------------------
# Machine Payments Protocol (Stripe + Tempo) — s'ajoute à x402, ne le remplace pas.
# Sans ces variables, MPP reste inerte et seul x402 encaisse.
#
# Tempo : stablecoin, aucun montant minimum, s'applique à TOUTES les routes.
TEMPO_PAY_TO=
# Stripe : carte bancaire via Shared Payment Token. Minimum 0,50 $ par débit,
# donc réservé aux routes chères. Exige la version d'API 2026-03-04.preview
# et l'accès anticipé MPP (stripe.com/blog/machine-payments-protocol).
STRIPE_SECRET_KEY=
STRIPE_PROFILE_ID=internal
